generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductionType {
  PLAY
  MUSICAL
  OPERA
  DANCE
  CONCERT
  STANDUP
  TALK
  OTHER
}

enum CreditRole {
  DIRECTOR
  WRITER
  /// Dramatisation or stage adaptation of someone else's work ("dramatisointi", "bearbetning").
  ADAPTATION
  COMPOSER
  TRANSLATOR
  CHOREOGRAPHER
  DESIGNER
  CAST
  OTHER
}

enum ScrapeStatus {
  RUNNING
  SUCCESS
  FAILED
}

model Theatre {
  id                String       @id @default(cuid())
  slug              String       @unique
  name              String
  city              String
  website           String
  ticketingProvider String?
  sourceId          String?      @unique
  stages            Stage[]
  productions       Production[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Stage {
  id           String        @id @default(cuid())
  theatreId    String
  theatre      Theatre       @relation(fields: [theatreId], references: [id])
  name         String
  productions  Production[]
  performances Performance[]

  @@unique([theatreId, name])
}

model Production {
  id             String          @id @default(cuid())
  slug           String          @unique
  title          String
  theatreId      String
  theatre        Theatre         @relation(fields: [theatreId], references: [id])
  stageId        String?
  stage          Stage?          @relation(fields: [stageId], references: [id])
  externalId     String
  sourceUrl      String
  type           ProductionType  @default(OTHER)
  typeConfidence Float           @default(0)
  typeOverride   ProductionType?
  languages      String[]
  subtitleLangs  String[]
  premiereDate   DateTime?
  runStart       DateTime?
  runEnd         DateTime?
  durationText   String?
  ticketUrl      String?
  /// Set when a complete run of the source no longer lists it (cancelled, removed); cleared if it returns.
  delistedAt     DateTime?
  lastSeenAt     DateTime
  performances   Performance[]
  credits        Credit[]
  criticReviews  CriticReview[]
  diaryEntries   DiaryEntry[]
  watchers       WatchItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([theatreId, externalId])
  @@index([runEnd])
}

model Performance {
  id            String       @id @default(cuid())
  productionId  String
  production    Production   @relation(fields: [productionId], references: [id])
  startsAt      DateTime
  stageId       String?
  stage         Stage?       @relation(fields: [stageId], references: [id])
  ticketUrl     String?
  /// Subtitles at this performance (e.g. only on Wednesdays); Production.subtitleLangs means every performance.
  subtitleLangs String[]     @default([])
  lastSeenAt    DateTime
  diaryEntries  DiaryEntry[]

  @@unique([productionId, startsAt])
  @@index([startsAt])
}

model Person {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  credits   Credit[]
  createdAt DateTime @default(now())
}

model Credit {
  id            String     @id @default(cuid())
  personId      String
  person        Person     @relation(fields: [personId], references: [id])
  productionId  String
  production    Production @relation(fields: [productionId], references: [id])
  role          CreditRole
  /// The source's own label ("Lavastussuunnittelu", "Ohjaus ja dramatisointi"); null when it gave none.
  roleText      String?
  characterName String?
  sortOrder     Int        @default(0)
  /// Same value as Production.lastSeenAt when the credit is still on the theatre's page.
  lastSeenAt    DateTime   @default(now())

  @@unique([personId, productionId, role])
  @@index([productionId])
}

model CriticReview {
  id           String     @id @default(cuid())
  productionId String
  production   Production @relation(fields: [productionId], references: [id])
  outlet       String
  /// The critic's name, when the source gives it.
  critic       String?
  url          String     @unique
  publishedAt  DateTime?
  /// The source marks the link as paywalled ("maksumuuri").
  paywalled    Boolean    @default(false)
  /// A feature or interview ("Lue juttu"), not a review: shown apart from the critics.
  feature      Boolean    @default(false)

  @@index([productionId])
}

/// Better Auth's user table (src/lib/auth.ts). `name` is the public display name.
model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified Boolean      @default(false)
  name          String       @default("")
  image         String?
  locale        String       @default("fi")
  /// Opt-in weekly "closing soon" email; locale above decides its language.
  digestOptIn   Boolean      @default(false)
  digestSentAt  DateTime?
  sessions      Session[]
  accounts      Account[]
  diaryEntries  DiaryEntry[]
  reports       Report[]
  watchlist     WatchItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

/// Magic-link tokens (Better Auth).
model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

/// Fixed-window counters shared by Better Auth and our own limits (src/lib/rate-limit.ts).
model RateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model DiaryEntry {
  id            String       @id @default(cuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  productionId  String
  production    Production   @relation(fields: [productionId], references: [id])
  performanceId String?
  performance   Performance? @relation(fields: [performanceId], references: [id])
  /// The calendar day in Helsinki, not a moment.
  seenOn        DateTime     @db.Date
  /// Half-stars, 1–10 (0.5–5 stars). Integer so it survives caching and never rounds oddly.
  rating        Int?
  review        String?
  /// The review text and display name show on the production page unless unticked.
  isPublic      Boolean      @default(true)
  isRewatch     Boolean      @default(false)
  /// Set by moderation; hidden entries still count anonymously in ratings and tags.
  hiddenAt      DateTime?
  tags          Tag[]
  reports       Report[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([productionId])
  @@index([userId, seenOn])
}

/// "Haluan nähdä": a show the user means to see. Private; removed when they log it as seen.
model WatchItem {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  productionId String
  production   Production @relation(fields: [productionId], references: [id])
  createdAt    DateTime   @default(now())

  @@id([userId, productionId])
  @@index([productionId])
}

enum ReportReason {
  SPOILER
  OFFENSIVE
  SPAM
  OTHER
}

model Report {
  id         String       @id @default(cuid())
  entryId    String
  entry      DiaryEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  reason     ReportReason
  createdAt  DateTime     @default(now())
  resolvedAt DateTime?

  @@unique([entryId, reporterId])
  @@index([resolvedAt])
}

model Tag {
  id        String       @id @default(cuid())
  slug      String       @unique
  sortOrder Int          @default(0)
  labelFi   String
  labelSv   String
  labelEn   String
  entries   DiaryEntry[]
}

model ScrapeRun {
  id           String       @id @default(cuid())
  sourceId     String
  status       ScrapeStatus @default(RUNNING)
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?
  itemsFound   Int          @default(0)
  itemsChanged Int          @default(0)
  errors       Json?

  @@index([sourceId, startedAt])
}
