DATABASE_URL="postgresql://postgres@localhost:5432/aitio"
# Optional: disposable database for the integration test (gets wiped)
# TEST_DATABASE_URL="postgresql://postgres@localhost:5432/aitio_test"
# Identify the scraper. Optional: by default built from SITE_URL and PRIVACY_EMAIL below
# SCRAPER_USER_AGENT="AitioBot/1.0 (+https://example.fi/tietoa; you@example.fi)"
# Auth (Better Auth): a long random string, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# Public origin; defaults to SITE_URL
# SITE_URL="https://aitio.fi"
# Email: Brevo (EU, the launch choice) or Resend; Brevo wins if both are set.
# Without a key, dev prints sign-in links to the console.
# BREVO_API_KEY=""
# RESEND_API_KEY=""
# EMAIL_FROM="Aitio <kirjaudu@aitio.fi>"
# Bearer token for Brevo's transactional webhook (/api/email/events): bounces stop the digest
# EMAIL_WEBHOOK_SECRET=""
# Tests only: append outgoing emails to this file instead (refused on Vercel production)
# DEV_EMAIL_LOG_FILE="/tmp/aitio-emails.jsonl"
# Lets the moderation CLI and the nightly scrape clear cached pages via /api/revalidate
# REVALIDATE_SECRET=""
# Vercel Cron sends this as a bearer token to the /api/cron/* routes
# CRON_SECRET=""
# Comma-separated: these accounts see /yllapito and get scrape failure emails
# ADMIN_EMAILS="you@example.fi"
# Privacy policy (/tietosuoja): who is responsible and how to reach them
# PRIVACY_CONTROLLER="Etunimi Sukunimi"
# PRIVACY_EMAIL="tietosuoja@aitio.fi"
# Before launch: pnpm launch:check .env.production.local (after vercel env pull)
